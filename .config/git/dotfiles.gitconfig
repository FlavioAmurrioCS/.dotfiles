################################################################################
# Location Docs: https://git-scm.com/docs/git-config#FILES
# Location User: ~/.config/git/dotfiles.gitconfig (included by ~/.config/git/config)
# Location Repo: none (per-repo settings live in each repo's .git/config)
# Location Check: git config --global --includes --list --show-origin
################################################################################
# Settings shared by every machine. ~/.config/git/config is an untracked stub
# from stubs/ that includes this file first, so `git config --global` writes
# there, never here, and its keys win. ~/.gitconfig, if a tool creates one, is
# read last and wins over both.

[alias]
  l = log --relative-date --decorate --graph --abbrev-commit
  ll = log --relative-date --decorate --all --graph --abbrev-commit
  tree = log --graph --decorate --pretty=oneline --abbrev-commit
[pager]
  branch = false
[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[pull]
  rebase = false
[user]
  name = Flavio Amurrio
  email = 25621374+FlavioAmurrioCS@users.noreply.github.com
