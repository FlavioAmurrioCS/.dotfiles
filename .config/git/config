################################################################################
# Location Docs: https://git-scm.com/docs/git-config#FILES
# Location User: ~/.config/git/config (~/.gitconfig must not exist, or it wins)
# Location Repo: none (per-repo settings live in each repo's .git/config)
# Location Check: git config --global --list --show-origin
################################################################################

[alias]
  l = log --relative-date --decorate --graph --abbrev-commit
  ll = log --relative-date --decorate --all --graph --abbrev-commit
  tree = log --graph --decorate --pretty=oneline --abbrev-commit
[pager]
  branch = false
[diff]
  tool = vscode
[difftool "vscode"]
  cmd = code --wait --diff $LOCAL $REMOTE
[color]
  ui = auto
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[pull]
  rebase = false
[user]
  name = Flavio Amurrio
  email = 25621374+FlavioAmurrioCS@users.noreply.github.com

# Untracked, per machine (for example a work email). Last, so it wins.
[include]
  path = ~/.config/git/config.local
