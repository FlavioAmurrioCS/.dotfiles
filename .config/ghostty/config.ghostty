################################################################################
# Location Docs: https://ghostty.org/docs/config#file-location
# Location User: ~/.config/ghostty/config.ghostty (Ghostty and cmux both read it)
# Location Repo: none (Ghostty has no project-level config)
# Location Check: ~/Applications/Ghostty.app/Contents/MacOS/ghostty +show-config | grep toggle_quick_terminal
################################################################################
# Comments must be on their own line: after a value they become part of it.
# Ghostty also loads ~/Library/Application Support/com.mitchellh.ghostty/config*
# after this file, and those win. Keep that directory free of config files.

# Show or hide the quick terminal from any app.
keybind = global:ctrl+opt+cmd+space=toggle_quick_terminal

# When you ssh from Ghostty, install its terminfo on the host the first time
# (ssh-terminfo), or fall back to TERM=xterm-256color (ssh-env). Without it,
# a host that doesn't know xterm-ghostty garbles backspace and other keys.
shell-integration-features = ssh-env,ssh-terminfo

theme = theme-sh-bright
