{
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "ruff.organizeImports": true,
  "notebook.formatOnSave.enabled": true,
  "notebook.codeActionsOnSave": {
    "notebook.source.fixAll": "explicit",
    "notebook.source.organizeImports": "explicit"
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  // shfmt reads .editorconfig; shuck's formatter differs (see shuck.toml).
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },
  // The ty extension provides the language server, so turn off Pylance's.
  "python.languageServer": "None",
  // Config files VS Code doesn't recognise by name (also see .gitattributes).
  "files.associations": {
    "shellcheckrc": "properties",
    "*.ghostty": "properties",
    "**/ghostty/themes/*": "properties",
    "**/.config/git/ignore": "ignore"
  }
}
